# =============================================
# 书法碑帖字体认证系统 - 环境变量配置
# =============================================
# 复制此文件为 .env 并填入你的真实密钥

# --- AI 服务密钥 ---

# SiliconFlow API Key (必需 - 字体识别)
# 从 https://siliconflow.cn/ 获取
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
#
# 是否启用 SiliconFlow（默认 true）
# SILICONFLOW_ENABLED=true

# 阿里云 DashScope / Qwen API Key (可选 - 题跋分析)
# QWEN_API_KEY=your_qwen_api_key_here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3-vl-plus
# QWEN_ENABLED=false
# QWEN_TRANSLATION_MODEL=qwen3.5-plus  # 翻译模型默认

# 智谱官方 GLM（必需 - 构图分析起承转合）
# ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_MODEL=glm-5v-turbo
# ZHIPU_ENABLED=true
#
# 强制指定题跋/区域分析使用的 LLM（可选：zhipu / qwen / siliconflow）
# 设置后将不再 fallback 到其他供应商
# TUBI_LLM_PROVIDER=zhipu

# MinerU 云 API（PDF 解析 - 精准解析 API）
# 从 https://mineru.net 获取 Token
# MINERU_API_TOKEN=your_mineru_api_token_here
# MINERU_API_BASE=https://mineru.net
# MINERU_MODEL_VERSION=vlm

# 百度 OCR API Key (可选 - 百度OCR识别)
BAIDU_OCR_API_KEY=your_baidu_api_key_here
BAIDU_OCR_SECRET_KEY=your_baidu_secret_key_here

# DeepSeek API Key (可选，已弃用)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# --- 向量数据库 ---

# Qdrant 配置 (构图分析模块使用)
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# --- 构图模块 ---

# 构图分析 API Key (为空则不验证)
# COMPOSITION_API_KEY=your_composition_api_key_here

# 构图 LLM 模型配置
# COMPOSITION_LLM_MODEL=qwen3.5-plus
# COMPOSITION_LLM_MAX_TOKENS=1400

# --- 服务配置 ---

# 后端端口 (默认 8001)
# SERVER_PORT=8001

# CORS 允许的来源 (逗号分隔，* 表示允许所有)
# CORS_ALLOW_ORIGINS=*

# --- 数据库/缓存 (可选) ---

# DATABASE_URL=sqlite:///data/calligraphy.db
# REDIS_URL=redis://localhost:6379/0

# --- 题跋（Tubi）精细面积（可选）---
#
# 开启后会对 AI 返回的绘画区域做像素级精修（GrabCut + 颜色精修），用于更精准的画材/留白面积
# TUBI_REFINE_PAINT_MASK=true
#
# 开启后会对 AI 返回的题跋区域做像素级精修（墨迹检测 + 连通域合并），并排除画材mask，得到更准确的题跋面积
# TUBI_REFINE_INSCRIPTION_MASK=true
#
# 保存调试图（mask/overlay）到 data/tubi_debug/<image_id>/
# TUBI_DEBUG_SAVE_IMAGES=true

# --- 画材精修：背景纸色过滤（深色/低对比背景关键）---
#
# 从四角采样背景色的比例（相对短边）
# TUBI_PAINT_BG_SAMPLE_RATIO=0.06
#
# 背景色距离阈值（DeltaE，越大越“把更多接近纸色的像素当背景剔除”）
# TUBI_PAINT_BG_DELTAE=12.0
#
# 背景纹理保留：当梯度低于该值时，才会执行“接近纸色”的剔除（越大越激进）
# TUBI_PAINT_BG_GRAD_MAX=8.0

# --- 扇子/灰线物件（画材）扩张调参 ---
#
# 扇子漏检或出现“中间分界线”时，优先调这里（越大越容易把扇子补全，但也更容易误扩张）
# TUBI_FAN_EXPAND_PAD_X_RATIO=0.18
# TUBI_FAN_EXPAND_PAD_Y_RATIO=0.12
# TUBI_FAN_EXPAND_RIGHT_EXT_RATIO=0.42
# TUBI_FAN_EXPAND_X_MARGIN_RATIO=0.15
# TUBI_FAN_EXPAND_BOTTOM_CUTOFF_RATIO=0.10
# TUBI_FAN_EDGE_DILATE_K=5
# TUBI_FAN_EDGE_DILATE_ITER=2
# TUBI_FAN_FAN_CLOSE_K=41
# TUBI_FAN_FAN_CLOSE_ITER=2
# TUBI_FAN_MAX_FILL_RATIO=0.35

# --- 题跋（inscription）精修调参 ---
#
# ROI 扩张比例（相对题跋 bbox）
# TUBI_INS_ROI_PAD_RATIO=0.08
#
# 墨迹检测：Otsu 阈值倍率（越小越敏感）+ 自适应阈值参数
# TUBI_INS_OTSU_MULT=0.80
# TUBI_INS_ADAPTIVE_BLOCK=21
# TUBI_INS_ADAPTIVE_C=12
#
# 墨迹去噪（open）
# TUBI_INS_INK_OPEN_K=3
# TUBI_INS_INK_OPEN_ITER=1
#
# 连通域连接（dilate）
# TUBI_INS_DILATE_KX=17
# TUBI_INS_DILATE_KY=29
# TUBI_INS_DILATE_ITER=1
#
# 连通域扩展（合并相邻块）
# TUBI_INS_GROW_MAX_DX_RATIO=0.10
# TUBI_INS_GROW_MAX_DY_RATIO=0.15
# TUBI_INS_GROW_MIN_AREA=150
# TUBI_INS_GROW_ITERS=5
# TUBI_INS_PAINT_OVERLAP_MAX=0.25
# TUBI_INS_DENSITY_MIN=0.12
#
# 收尾清理
# TUBI_INS_CLEAN_OPEN_K=7
# TUBI_INS_CLEAN_OPEN_ITER=2
# TUBI_INS_CLEAN_CLOSE_K=3
# TUBI_INS_CLEAN_CLOSE_ITER=2
#
# 印章并入题跋（HSV + gate + 形状筛选）
# TUBI_SEAL_H_MAX=20
# TUBI_SEAL_S_MIN=20
# TUBI_SEAL_V_MIN=60
# TUBI_SEAL_GATE_PAD_RATIO=0.05
# TUBI_SEAL_AREA_MIN=80
# TUBI_SEAL_AREA_MAX=40000
# TUBI_SEAL_AR_MIN=0.4
# TUBI_SEAL_AR_MAX=2.5
# TUBI_SEAL_MEAN_S_MIN=22
# TUBI_SEAL_MEAN_V_MAX=245
