.container {
  padding: 20rpx 30rpx;
  min-height: 100vh;
  background: #f8f5f0;
}

.lib-header {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.lib-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #2c2416;
  display: block;
  margin-bottom: 8rpx;
}

.lib-artist {
  font-size: 26rpx;
  color: #8b7d6b;
  display: block;
  margin-bottom: 8rpx;
}

.lib-desc {
  font-size: 24rpx;
  color: #b0a594;
  display: block;
  margin-bottom: 16rpx;
}

.lib-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.lib-vis {
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.vis-public {
  background: #e8f5e9;
  color: #2e7d32;
}

.vis-private {
  background: #f5f5f5;
  color: #8b7d6b;
}

.lib-count {
  font-size: 24rpx;
  color: #8b7d6b;
}

.section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #2c2416;
  margin-bottom: 16rpx;
}

.loading-wrap, .empty-wrap {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text, .empty-text {
  font-size: 26rpx;
  color: #8b7d6b;
}

.artwork-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.artwork-card {
  width: calc(50% - 8rpx);
  background: #fff;
  border-radius: 10rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.03);
}

.artwork-thumb {
  width: 100%;
  height: 240rpx;
  background: #f5efe0;
}

.artwork-thumb-placeholder {
  width: 100%;
  height: 240rpx;
  background: linear-gradient(135deg, #f5efe0, #ebe3d3);
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 48rpx;
  color: #c9a96e;
}

.artwork-info {
  padding: 16rpx;
}

.artwork-title {
  font-size: 26rpx;
  color: #2c2416;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.artwork-meta {
  font-size: 22rpx;
  color: #8b7d6b;
  display: block;
  margin-top: 4rpx;
}

.loading-more {
  text-align: center;
  padding: 30rpx;
  font-size: 24rpx;
  color: #b0a594;
}
