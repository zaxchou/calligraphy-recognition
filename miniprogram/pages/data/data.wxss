/* Data page — minimal overrides beyond global */

/* Phase 4c: 公共/我的 Tab 样式 */
.view-tabs {
  display: flex;
  justify-content: center;
  gap: 0;
  padding: 16rpx 24rpx 0;
}
.view-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #8a877e;
  border-bottom: 3rpx solid transparent;
  transition: all 0.2s;
}
.view-tab.active {
  color: #c96442;
  border-bottom-color: #c96442;
}
