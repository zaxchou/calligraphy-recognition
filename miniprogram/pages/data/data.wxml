<view class="page">

  <!-- Phase 4c: 公共/我的 Tab 切换 -->
  <view class="view-tabs">
    <view class="view-tab {{activeTab==='public'?'active':''}}" data-tab="public" bindtap="onSwitchTab">📊 公共统计</view>
    <view class="view-tab {{activeTab==='my'?'active':''}}" data-tab="my" bindtap="onSwitchTab">📈 我的统计</view>
  </view>

  <!-- Phase 4c: 我的统计视图 -->
  <block wx:if="{{activeTab==='my'}}">
    <view class="empty-state" wx:if="{{!hasToken}}">
      <view class="empty-icon">🔐</view>
      <view class="empty-text">登录后查看个人统计</view>
    </view>
    <block wx:else>
      <view class="empty-state" wx:if="{{myLoading}}">
        <view class="empty-icon">⌛</view>
        <view class="empty-text">加载中...</view>
      </view>
      <block wx:elif="{{myStats}}">
        <view class="data-stats">
          <view class="stat-card">
            <view class="stat-num">{{myStats.total_count || 0}}</view>
            <view class="stat-label">我的作品总数</view>
          </view>
          <view class="stat-card">
            <view class="stat-num">{{myPublicTotal || 0}}</view>
            <view class="stat-label">公共作品总数</view>
          </view>
        </view>
        <view class="data-section" wx:if="{{myStats.sentiment_distribution.length > 0}}">
          <view class="data-section-title">我的情感分布</view>
          <view class="d-table">
            <view class="d-tr d-th"><view class="d-td">极性</view><view class="d-td">作品数</view><view class="d-td">占比</view></view>
            <view class="d-tr" wx:for="{{myStats.sentiment_distribution}}" wx:key="polarity">
              <view class="d-td">{{item.polarity==='positive'?'积极':item.polarity==='negative'?'消极':'中性'}}</view>
              <view class="d-td">{{item.count}}</view>
              <view class="d-td">{{item.percentage}}%</view>
            </view>
          </view>
        </view>
        <view class="data-section" wx:if="{{myStats.period_stats.length > 0}}">
          <view class="data-section-title">我的时期分布</view>
          <view class="d-table">
            <view class="d-tr d-th"><view class="d-td">时期</view><view class="d-td">作品数</view><view class="d-td">均字数</view></view>
            <view class="d-tr" wx:for="{{myStats.period_stats}}" wx:key="period">
              <view class="d-td">{{item.period}}</view>
              <view class="d-td">{{item.count}}</view>
              <view class="d-td">{{item.avg_char_count}}</view>
            </view>
          </view>
        </view>
        <view class="data-section" wx:if="{{myStats.size_distribution.length > 0}}">
          <view class="data-section-title">我的尺寸分布</view>
          <view class="d-table">
            <view class="d-tr d-th"><view class="d-td">类别</view><view class="d-td">数量</view><view class="d-td">占比</view></view>
            <view class="d-tr" wx:for="{{myStats.size_distribution}}" wx:key="category">
              <view class="d-td">{{item.category}}</view>
              <view class="d-td">{{item.count}}</view>
              <view class="d-td">{{item.percentage}}%</view>
            </view>
          </view>
        </view>
        <view class="empty-state" wx:if="{{myStats.total_count === 0}}">
          <view class="empty-icon">📊</view>
          <view class="empty-text">暂无个人作品数据</view>
        </view>
      </block>
      <view class="empty-state" wx:elif="{{myError}}">
        <view class="empty-text">加载失败</view>
      </view>
    </block>
  </block>

  <!-- Phase 4c: 公共统计视图 -->
  <block wx:if="{{activeTab==='public'}}">

  <view class="empty-state" wx:if="{{loading}}">
    <view class="empty-icon">⌛</view>
    <view class="empty-text">加载数据...</view>
  </view>

  <block wx:if="{{!loading}}">

    <!-- Top Stat -->
    <view class="data-stats">
      <view class="stat-card">
        <view class="stat-num">{{totalWorks}}</view>
        <view class="stat-label">题跋作品总数</view>
      </view>
    </view>

    <!-- 1. 情感极性总体分布 -->
    <view class="data-section">
      <view class="data-section-title">情感极性总体分布</view>
      <view class="d-table">
        <view class="d-tr d-th">
          <view class="d-td">极性</view>
          <view class="d-td">占比</view>
        </view>
        <view class="d-tr">
          <view class="d-td"><text class="d-dot" style="background:#c04030;"></text>消极</view>
          <view class="d-td">{{negPctStr}}</view>
        </view>
        <view class="d-tr">
          <view class="d-td"><text class="d-dot" style="background:#67c23a;"></text>积极</view>
          <view class="d-td">{{posPctStr}}</view>
        </view>
        <view class="d-tr">
          <view class="d-td"><text class="d-dot" style="background:#8b7d6b;"></text>中性</view>
          <view class="d-td">{{neuPctStr}}</view>
        </view>
      </view>
    </view>

    <!-- 2. 分期作品占比 -->
    <view class="data-section" wx:if="{{periodItems.length > 0}}">
      <view class="data-section-title">分期作品占比</view>
      <view class="d-table">
        <view class="d-tr d-th">
          <view class="d-td">时期</view>
          <view class="d-td">作品数</view>
          <view class="d-td">占比</view>
        </view>
        <view class="d-tr" wx:for="{{periodItems}}" wx:key="label">
          <view class="d-td">{{item.label}}</view>
          <view class="d-td">{{item.count}}</view>
          <view class="d-td">{{item.pct}}%</view>
        </view>
      </view>
    </view>

    <!-- 3. 作品尺寸统计 -->
    <view class="data-section" wx:if="{{sizeItems.length > 0}}">
      <view class="data-section-title">作品尺寸统计</view>
      <view class="d-table">
        <view class="d-tr d-th">
          <view class="d-td">类别</view>
          <view class="d-td">数量</view>
          <view class="d-td">占比</view>
        </view>
        <view class="d-tr" wx:for="{{sizeItems}}" wx:key="category">
          <view class="d-td">{{item.category}}</view>
          <view class="d-td">{{item.count}}</view>
          <view class="d-td">{{item.pct}}%</view>
        </view>
      </view>
    </view>

    <!-- 各时期平均尺寸 -->
    <view class="data-section" wx:if="{{periodSizeItems.length > 0}}">
      <view class="data-section-title">各时期平均尺寸</view>
      <view class="d-table">
        <view class="d-tr d-th">
          <view class="d-td">时期</view>
          <view class="d-td">均高 cm</view>
          <view class="d-td">均宽 cm</view>
          <view class="d-td">作品数</view>
        </view>
        <view class="d-tr" wx:for="{{periodSizeItems}}" wx:key="period">
          <view class="d-td">{{item.period}}</view>
          <view class="d-td">{{item.avgH}}</view>
          <view class="d-td">{{item.avgW}}</view>
          <view class="d-td">{{item.count}}</view>
        </view>
      </view>
    </view>

    <!-- 4. 题跋闯入率 -->
    <view class="data-section" wx:if="{{invasiveItems.length > 0}}">
      <view class="data-section-title">题跋闯入率</view>
      <view class="d-table">
        <view class="d-tr d-th">
          <view class="d-td">主题</view>
          <view class="d-td">闯入率</view>
          <view class="d-td">闯入/总数</view>
        </view>
        <view class="d-tr" wx:for="{{invasiveItems}}" wx:key="theme">
          <view class="d-td">{{item.theme}}</view>
          <view class="d-td">{{item.rate}}%</view>
          <view class="d-td">{{item.invasive}} / {{item.invasive + item.nonInvasive}}</view>
        </view>
      </view>
    </view>

    <!-- 5. 题跋面积分布 -->
    <view class="data-section" wx:if="{{areaDistItems.length > 0}}">
      <view class="data-section-title">题跋面积分布</view>
      <view class="d-table">
        <view class="d-tr d-th">
          <view class="d-td">面积区间</view>
          <view class="d-td">作品数</view>
          <view class="d-td">占比</view>
        </view>
        <view class="d-tr" wx:for="{{areaDistItems}}" wx:key="range">
          <view class="d-td">{{item.range}}</view>
          <view class="d-td">{{item.count}}</view>
          <view class="d-td">{{item.pct}}%</view>
        </view>
      </view>
    </view>

    <view style="height: 80rpx;"></view>
  </block>

  </block><!-- End public tab wrapper -->

</view>
