<view class="page">

  <!-- ===== Search Bar (always visible) ===== -->
  <view class="search-wrap">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input
        placeholder="搜索写意画知识..."
        value="{{searchQuery}}"
        bindinput="onSearchInput"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
        bindconfirm="onSearchConfirm"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{searchQuery}}" bindtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- ===== Browse State ===== -->
  <block wx:if="{{state === 'browse' || state === 'searching'}}">
    <!-- Stats -->
    <view class="stat-row" wx:if="{{stats.total_books > 0}}">
      <view class="stat-card">
        <view class="stat-num">{{stats.total_books}}</view>
        <view class="stat-label">馆藏书籍</view>
      </view>
      <view class="stat-card">
        <view class="stat-num">{{stats.total_chunks}}</view>
        <view class="stat-label">文本块</view>
      </view>
      <view class="stat-card">
        <view class="stat-num">{{stats.total_images}}</view>
        <view class="stat-label">配图</view>
      </view>
    </view>

    <view class="section-title">馆 藏 书 库</view>

    <!-- Loading -->
    <view class="empty-state" wx:if="{{loading}}">
      <view class="empty-icon">⌛</view>
      <view class="empty-text">加载中...</view>
    </view>

    <!-- Book List -->
    <view class="book-list" wx:if="{{!loading && books.length > 0}}">
      <view
        class="book-card card-gold-left"
        wx:for="{{books}}"
        wx:key="id"
        data-id="{{item.id}}"
        bindtap="onBookTap"
      >
        <view class="book-cover" style="color: {{item.coverColor}}">
          {{item.coverChar}}
        </view>
        <view class="book-info">
          <view class="book-title">{{item.title}}</view>
          <view class="book-meta">{{item.author || '未知作者'}} · {{item.chapterCount}} 条文本</view>
          <view class="book-status">已入库 ✓</view>
        </view>
      </view>
    </view>

    <!-- Empty -->
    <view class="empty-state" wx:if="{{!loading && books.length === 0}}">
      <view class="empty-icon">📚</view>
      <view class="empty-text">暂无馆藏书籍</view>
    </view>
  </block>

  <!-- ===== Searching State ===== -->
  <view class="empty-state" wx:if="{{state === 'searching'}}">
    <view class="empty-icon">🔍</view>
    <view class="empty-text">搜索中...</view>
  </view>

  <!-- ===== Results State ===== -->
  <block wx:if="{{state === 'results'}}">

    <!-- AI Summary -->
    <view class="ai-summary-card" wx:if="{{aiSummary && aiSummary.answerHtml}}">
      <view class="ai-header">
        <text class="ai-badge">AI 概述</text>
        <text class="ai-title" wx:if="{{aiSummary.confidencePct}}">置信度 {{aiSummary.confidencePct}}</text>
      </view>
      <rich-text nodes="{{aiSummary.answerHtml}}"></rich-text>
      <!-- Key points -->
      <view wx:if="{{aiSummary.key_points && aiSummary.key_points.length > 0}}" style="margin-top: 16rpx;">
        <view wx:for="{{aiSummary.key_points}}" wx:key="*this" style="font-size: 26rpx; color: #2c2416; padding: 6rpx 0;">
          • {{item}}
        </view>
      </view>
      <!-- Related images -->
      <view class="image-grid" wx:if="{{relatedImages.length > 0}}" style="padding: 0; margin-top: 16rpx;">
        <block wx:for="{{relatedImages}}" wx:key="url">
          <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="onImageTap"/>
        </block>
      </view>
    </view>

    <!-- No results -->
    <view class="empty-state" wx:if="{{searchResults.length === 0}}">
      <view class="empty-icon">🔍</view>
      <view class="empty-text">未找到相关结果</view>
    </view>

    <!-- Results -->
    <view class="search-hint" wx:if="{{searchResults.length > 0}}">
      搜索结果 · {{searchTotal}} 条
    </view>
    <view class="result-list" wx:if="{{searchResults.length > 0}}">
      <view
        class="result-item"
        wx:for="{{searchResults}}"
        wx:key="chunk_id"
        data-book-id="{{item.book_id}}"
        data-index="{{index}}"
        bindtap="onResultTap"
      >
        <view class="result-header">
          <text class="result-book">
            <text wx:if="{{item.source === 'private'}}" style="color: #c96442;">[我的] </text>{{item.book_title}}
          </text>
          <text class="result-score" wx:if="{{item.score}}">{{item.scorePct}}%</text>
        </view>
        <view class="result-text">{{item.content}}</view>
        <view class="result-loc" wx:if="{{item.locText}}">{{item.locText}}</view>
      </view>
    </view>
  </block>

  <!-- ===== Detail State ===== -->
  <block wx:if="{{state === 'detail' && currentBook}}">
    <view class="nav-back" bindtap="onBackFromDetail">← 返回书库</view>

    <view class="detail-header">
      <view class="detail-title">{{currentBook.title || '未命名'}}</view>
      <view class="detail-meta">{{currentBook.author || '未知作者'}}{{currentBook.chapterCount ? ' · ' + currentBook.chapterCount + '条文本' : ''}}</view>
    </view>

    <!-- Tabs -->
    <view class="detail-tabs">
      <view class="detail-tab {{detailTab === 'outline' ? 'active' : ''}}" data-tab="outline" bindtap="onSwitchDetailTab">大纲</view>
      <view class="detail-tab {{detailTab === 'content' ? 'active' : ''}}" data-tab="content" bindtap="onSwitchDetailTab">正文</view>
      <view class="detail-tab {{detailTab === 'images' ? 'active' : ''}}" data-tab="images" bindtap="onSwitchDetailTab">配图</view>
    </view>

    <!-- Outline Tab -->
    <view class="outline-list" wx:if="{{detailTab === 'outline'}}">
      <block wx:if="{{outline && outline.length > 0}}">
        <view class="outline-item" wx:for="{{outline}}" wx:key="index">
          <view class="outline-chapter">
            <text class="outline-arrow">{{item.expanded ? '▾' : '▸'}}</text>
            <text>{{item.title || ('第' + (index + 1) + '章')}}</text>
          </view>
          <view class="outline-sections" wx:if="{{item.sections && item.sections.length > 0 && item.expanded}}">
            <view class="outline-section" wx:for="{{item.sections}}" wx:key="index" wx:for-item="sec">
              {{sec.title || sec}}
            </view>
          </view>
        </view>
      </block>
      <view class="empty-state" wx:else>
        <view class="empty-text">暂无大纲</view>
      </view>
    </view>

    <!-- Content Tab -->
    <view class="markdown-body" wx:if="{{detailTab === 'content'}}">
      <!-- Matched result card from search -->
      <view class="match-card" wx:if="{{matchedResult}}">
        <view class="match-header">🔍 搜索匹配结果</view>
        <view class="match-book" wx:if="{{matchedResult.book_title}}">{{matchedResult.book_title}}</view>
        <view class="match-loc" wx:if="{{matchedResult.locText}}">{{matchedResult.locText}}</view>
        <view class="match-text">{{matchedResult.content}}</view>
      </view>
      <rich-text nodes="{{markdownHtml}}" wx:if="{{markdownHtml}}"></rich-text>
      <view class="empty-state" wx:else>
        <view class="empty-text">加载中...</view>
      </view>
    </view>

    <!-- Images Tab -->
    <view wx:if="{{detailTab === 'images'}}">
      <view class="image-grid" wx:if="{{bookImages.length > 0}}">
        <block wx:for="{{bookImages}}" wx:key="id">
          <image wx:if="{{item.url}}" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" bindtap="onImageTap"/>
        </block>
      </view>
      <view class="empty-state" wx:else>
        <view class="empty-text">暂无配图</view>
      </view>
    </view>
  </block>

</view>
