<view class="page">

  <!-- ===== List State ===== -->
  <block wx:if="{{state === 'list'}}">
    <!-- ===== Overview ===== -->
    <view class="t-overview" wx:if="{{overview}}">
      <view class="t-ov-header">题跋数据概览</view>

      <view class="t-ov-stats">
        <view class="t-ov-stat">
          <view class="t-ov-num">{{overview.totalWorks}}</view>
          <view class="t-ov-lbl">件题跋作品</view>
        </view>
      </view>

      <!-- Sentiment -->
      <view class="t-ov-senti" wx:if="{{overview.negPct > 0 || overview.posPct > 0}}">
        <view class="t-ov-senti-bar">
          <view class="t-ov-senti-seg t-ov-senti-neg" style="width: {{overview.negPct}}%;" wx:if="{{overview.negPct > 0}}"></view>
          <view class="t-ov-senti-seg t-ov-senti-pos" style="width: {{overview.posPct}}%;" wx:if="{{overview.posPct > 0}}"></view>
          <view class="t-ov-senti-seg t-ov-senti-neu" style="width: {{overview.neuPct}}%;" wx:if="{{overview.neuPct > 0}}"></view>
        </view>
        <view class="t-ov-senti-legend">
          <text class="t-ov-leg-item"><text class="t-ov-leg-dot" style="background:#c04030;"></text>消极 {{overview.negPct}}%</text>
          <text class="t-ov-leg-item"><text class="t-ov-leg-dot" style="background:#67c23a;"></text>积极 {{overview.posPct}}%</text>
          <text class="t-ov-leg-item"><text class="t-ov-leg-dot" style="background:#8b7d6b;"></text>中性 {{overview.neuPct}}%</text>
        </view>
      </view>

      <!-- Periods -->
      <view class="t-ov-periods" wx:if="{{overview.periods.length > 0}}">
        <text class="t-ov-period" wx:for="{{overview.periods}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <!-- Chart Card: 分期 × 题跋面积 -->
    <view class="t-overview" wx:if="{{overview && overview.periodStats && overview.periodStats.length > 0}}" style="margin-top: 0; margin-bottom: 16rpx;">
      <view class="t-ov-header" style="margin-bottom: 20rpx;">分期 × 题跋面积</view>
      <view class="t-ov-chart-subtitle">各时期平均题跋字数</view>
      <canvas type="2d" id="periodChart" class="t-ov-chart" style="height: {{overview.periodChartH}}px;"></canvas>
    </view>

    <!-- Chart Card: 主题 × 题跋面积 -->
    <view class="t-overview" wx:if="{{overview && overview.topThemes.length > 0}}" style="margin-top: 0; margin-bottom: 16rpx;">
      <view class="t-ov-header" style="margin-bottom: 20rpx;">主题 × 题跋面积</view>
      <view class="t-ov-chart-subtitle">Top 5 主题作品数</view>
      <canvas type="2d" id="themeChart2" class="t-ov-chart" style="height: {{overview.themeChartH}}px;"></canvas>
    </view>

    <view class="filter-bar">
      <picker class="filter-picker" range="{{artistList}}" value="{{artistIndex}}" bindchange="onArtistChange">
        <view class="picker-text">{{artistList[artistIndex]}} ▾</view>
      </picker>
      <view class="filter-count" wx:if="{{total > 0}}">共 {{total}} 件</view>
    </view>

    <view class="empty-state" wx:if="{{loading && artworks.length === 0}}">
      <view class="empty-icon">⌛</view>
      <view class="empty-text">加载中...</view>
    </view>

    <view class="tubi-grid" wx:if="{{!loading || artworks.length > 0}}">
      <view class="tubi-card" wx:for="{{artworks}}" wx:key="id" data-id="{{item.id}}" bindtap="onArtworkTap">
        <image wx:if="{{item.thumbUrl}}" class="tubi-card-img" src="{{item.thumbUrl}}" mode="aspectFill" lazy-load/>
        <view wx:else class="tubi-card-img" style="display:flex;align-items:center;justify-content:center;color:#d4c8b0;font-size:48rpx;">🖼</view>
        <view class="tubi-card-info">
          <view class="tubi-card-title">{{item.title}}</view>
          <view class="tubi-card-artist">{{item.artist}}</view>
          <view class="tubi-card-meta" wx:if="{{item.year && item.year !== '未知'}}">{{item.year}}年</view>
          <view class="tubi-card-meta" wx:if="{{item.inscriptionPct != null}}">
            <text>题跋 {{item.inscriptionPct}}% · 画心 {{item.paintingPct}}%</text>
          </view>
        </view>
      </view>
    </view>

    <view class="load-more" wx:if="{{hasMore && artworks.length > 0}}" bindtap="onLoadMore">
      {{loading ? '加载中...' : '加载更多 ▾'}}
    </view>

    <view class="empty-state" wx:if="{{!loading && artworks.length === 0}}">
      <view class="empty-icon">🖼</view>
      <view class="empty-text">暂无作品</view>
    </view>
  </block>

  <!-- ===== Detail State ===== -->
  <block wx:if="{{state === 'detail'}}">
    <view class="nav-back" bindtap="onBackFromDetail">← 作品库</view>

    <view class="empty-state" wx:if="{{detailLoading}}">
      <view class="empty-icon">⌛</view>
      <view class="empty-text">加载中...</view>
    </view>

    <block wx:if="{{!detailLoading && currentArtwork}}">

      <!-- HERO: Image -->
      <view class="d-hero">
        <image class="d-hero-img" src="{{currentArtwork.imageUrl}}" mode="widthFix" bindtap="onPreviewHero" data-url="{{currentArtwork.imageUrl}}"/>
      </view>

      <!-- Regions Overlay -->
      <view class="d-section" wx:if="{{currentArtwork.hasRegions}}" style="padding-bottom: 0;">
        <view class="d-section-label">面积示意</view>
        <canvas type="2d" id="regionsCanvas" class="d-regions-canvas" style="height: {{currentArtwork.regionsCanvasH}}px;"></canvas>
        <view class="d-ratio-legend" style="margin-bottom: 8rpx;">
          <text class="d-legend-dot d-dot-insc"></text><text>题跋区域</text>
          <text class="d-legend-dot d-dot-paint"></text><text>画心区域</text>
        </view>
      </view>

      <!-- TITLE BLOCK -->
      <view class="d-title-block">
        <view class="d-title">《{{currentArtwork.title}}》</view>
        <view class="d-subtitle">
          <text>{{currentArtwork.artist}}</text>
          <text wx:if="{{currentArtwork.year && currentArtwork.year !== '年代不详'}}" class="d-sub-sep">·</text>
          <text wx:if="{{currentArtwork.year && currentArtwork.year !== '年代不详'}}">{{currentArtwork.year}}年</text>
        </view>
        <view class="d-period-tag" wx:if="{{currentArtwork.period}}">{{currentArtwork.period}}</view>
      </view>

      <!-- RATIO BAR — hero data viz -->
      <view class="d-section" wx:if="{{currentArtwork.inscriptionPct != null}}">
        <view class="d-section-label">画面构成</view>
        <view class="d-ratio-bar">
          <view class="d-ratio-seg d-ratio-insc" style="width: {{currentArtwork.inscriptionPct}}%;" wx:if="{{currentArtwork.inscriptionPct > 0}}">
            <text wx:if="{{currentArtwork.inscriptionPct > 12}}">题跋 {{currentArtwork.inscriptionPct}}%</text>
          </view>
          <view class="d-ratio-seg d-ratio-paint" style="width: {{currentArtwork.paintingPct}}%;" wx:if="{{currentArtwork.paintingPct > 0}}">
            <text wx:if="{{currentArtwork.paintingPct > 12}}">画心 {{currentArtwork.paintingPct}}%</text>
          </view>
          <view class="d-ratio-seg d-ratio-blank" style="width: {{currentArtwork.blankPct}}%;" wx:if="{{currentArtwork.blankPct > 0}}">
            <text wx:if="{{currentArtwork.blankPct > 12}}">留白 {{currentArtwork.blankPct}}%</text>
          </view>
        </view>
        <view class="d-ratio-legend">
          <text class="d-legend-dot d-dot-insc"></text><text>题跋</text>
          <text class="d-legend-dot d-dot-paint"></text><text>画心</text>
          <text class="d-legend-dot d-dot-blank"></text><text>留白</text>
        </view>
      </view>

      <!-- META CARDS -->
      <view class="d-meta-row" wx:if="{{currentArtwork.widthCm || currentArtwork.heightCm}}">
        <view class="d-meta-item" wx:if="{{currentArtwork.heightCm}}">
          <view class="d-meta-val">{{currentArtwork.heightCm}}</view>
          <view class="d-meta-lbl">纵 cm</view>
        </view>
        <view class="d-meta-item" wx:if="{{currentArtwork.widthCm}}">
          <view class="d-meta-val">{{currentArtwork.widthCm}}</view>
          <view class="d-meta-lbl">横 cm</view>
        </view>
        <view class="d-meta-item" wx:if="{{currentArtwork.albumIndex != null}}">
          <view class="d-meta-val">{{currentArtwork.albumIndex}}</view>
          <view class="d-meta-lbl">册页序</view>
        </view>
      </view>

      <!-- TAGS -->
      <view class="d-tags" wx:if="{{currentArtwork.tags.length > 0}}">
        <text class="d-tag-pill" wx:for="{{currentArtwork.tags}}" wx:key="*this">{{item}}</text>
      </view>

      <!-- ALBUM -->
      <view class="d-section" wx:if="{{currentArtwork.albumName}}">
        <view class="d-section-label">册页</view>
        <view class="d-plain-text">{{currentArtwork.albumName}}</view>
      </view>

      <!-- SEAL -->
      <view class="d-section" wx:if="{{currentArtwork.sealContent}}">
        <view class="d-section-label">印章</view>
        <view class="d-seal-text">{{currentArtwork.sealContent}}</view>
      </view>

      <!-- INSCRIPTION -->
      <view class="d-section" wx:if="{{currentArtwork.inscriptionText}}">
        <view class="d-section-label">题跋原文</view>
        <view class="d-inscription-block">{{currentArtwork.inscriptionText}}</view>
      </view>

      <!-- TRANSLATION -->
      <view class="d-section" wx:if="{{currentArtwork.translatedText}}">
        <view class="d-section-label">释文</view>
        <view class="d-plain-text">{{currentArtwork.translatedText}}</view>
      </view>

      <!-- AI ANALYSIS CARD -->
      <view class="d-ai-card" wx:if="{{currentArtwork.aiAnalysisHtml}}">
        <view class="d-ai-header">
          <view class="d-ai-badge">AI 分析</view>
        </view>
        <rich-text nodes="{{currentArtwork.aiAnalysisHtml}}"></rich-text>
      </view>

      <!-- CONTENT TAGS -->
      <view class="d-section" wx:if="{{currentArtwork.contentTags.length > 0}}">
        <view class="d-section-label">内容分类</view>
        <view class="d-tags">
          <text class="d-tag-pill d-tag-theme" wx:for="{{currentArtwork.contentTags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <!-- MATERIAL -->
      <view class="d-section" wx:if="{{currentArtwork.materialTags && currentArtwork.materialTags.length > 0}}">
        <view class="d-section-label">材质技法</view>
        <view class="d-tags">
          <text class="d-tag-pill d-tag-material" wx:for="{{currentArtwork.materialTags}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view style="height: 80rpx;"></view>
    </block>
  </block>

</view>
