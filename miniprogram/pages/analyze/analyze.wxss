/* ========= 全局 ========= */
page {
  background: #faf8f3;
  font-family: -apple-system, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  color: #292524;
}

.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
}

/* ========= 共用 ========= */
.flex-1 { flex: 1; }

.btn-primary {
  background: #292524;
  color: #fff;
  font-size: 30rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  border: none;
  width: 100%;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.btn-primary[loading] {
  opacity: 0.7;
}

.btn-outline {
  background: transparent;
  color: #57534e;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  border: 2rpx solid #d6d3d1;
  font-weight: 400;
}

.btn-share {
  background: #f0ede8;
  color: #292524;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  border: none;
  font-weight: 500;
}

.dual-btn {
  display: flex;
  gap: 20rpx;
  margin-top: 36rpx;
}

.preview-img {
  width: 100%;
  border-radius: 20rpx;
  overflow: hidden;
}

.preview-img.dim {
  opacity: 0.5;
}

/* ========= Hero (idle) ========= */
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
}

.hero-icon {
  font-size: 80rpx;
  color: #d6d3d1;
  margin-bottom: 40rpx;
  font-weight: 200;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1c1917;
  margin-bottom: 20rpx;
  letter-spacing: 2rpx;
}

.hero-desc {
  display: block;
  font-size: 28rpx;
  color: #78716c;
  text-align: center;
  line-height: 1.8;
  max-width: 480rpx;
  margin-bottom: 60rpx;
}

.hero-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.demo-link {
  margin-top: 32rpx;
  padding: 16rpx 0;
}

.demo-link-text {
  font-size: 26rpx;
  color: #a8a29e;
  letter-spacing: 0.5rpx;
}

/* ========= Preview header ========= */
.preview-header {
  margin-bottom: 28rpx;
}

.preview-label {
  font-size: 28rpx;
  color: #78716c;
  font-weight: 500;
}

/* ========= 进度 (analyzing) ========= */
.progress-section {
  margin-top: 48rpx;
  text-align: center;
}

.progress-label {
  display: block;
  font-size: 28rpx;
  color: #44403c;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.progress-track {
  height: 8rpx;
  background: #e7e5e4;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  height: 100%;
  background: #292524;
  border-radius: 4rpx;
  transition: width 0.4s ease;
}

.progress-num {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #1c1917;
  margin-bottom: 16rpx;
}

.progress-stage {
  display: block;
  font-size: 26rpx;
  color: #78716c;
}

.progress-eta {
  display: block;
  font-size: 24rpx;
  color: #a8a29e;
  margin-top: 8rpx;
}

/* ========= 总评卡片 ========= */
.score-card {
  display: flex;
  align-items: center;
  gap: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 25, 23, 0.04);
}

.score-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #292524;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.score-ring-inner {
  text-align: center;
  line-height: 1;
}

.score-num {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1c1917;
}

.score-unit {
  display: block;
  font-size: 22rpx;
  color: #78716c;
  margin-top: 2rpx;
}

.score-meta {
  flex: 1;
}

.score-label {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1917;
  margin-bottom: 8rpx;
}

.score-note {
  display: block;
  font-size: 24rpx;
  color: #a8a29e;
  line-height: 1.6;
}

/* ========= 媒体卡片（雷达 + 覆层） ========= */
.media-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 25, 23, 0.04);
}

.media-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #44403c;
  margin-bottom: 28rpx;
}

.media-note {
  display: block;
  font-size: 21rpx;
  color: #c4bfb8;
  text-align: center;
  margin-top: 24rpx;
  letter-spacing: 0.5rpx;
}

/* ========= Canvas 雷达图 ========= */
.radar-canvas {
  width: 100%;
  height: 540rpx;
  display: block;
}

/* ========= qczh 结果图 ========= */
.qczh-result-img {
  width: 100%;
  border-radius: 12rpx;
}

/* ========= qczh 加载中占位 ========= */
.qczh-loading-card {
  border: 2rpx dashed #d6d3d1;
  background: #faf8f3;
}

.qczh-loading-body {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.qczh-loading-icon {
  font-size: 52rpx;
  color: #a8a29e;
  animation: qczhSpin 2s linear infinite;
}

@keyframes qczhSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.qczh-loading-text {
  font-size: 28rpx;
  color: #78716c;
  margin-top: 24rpx;
}

.qczh-loading-hint {
  font-size: 22rpx;
  color: #c4bfb8;
  margin-top: 12rpx;
}

/* ========= Mock 起承转合覆层 ========= */
.mock-overlay {
  position: relative;
  width: 100%;
  height: 400rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

/* 模拟原图底 */
.ov-bg-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* 暗色遮罩 */
.ov-dim-mask {
  position: absolute;
  inset: 0;
  background: rgba(28, 25, 23, 0.45);
  z-index: 2;
}

/* 标注层 */
.ov-markers {
  position: absolute;
  inset: 0;
  z-index: 3;
}

.mock-ov-stage {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.ov-tag {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
  letter-spacing: 2rpx;
}

.ov-tag-qi    { background: #d4a574; }
.ov-tag-cheng { background: #8daa94; }
.ov-tag-zhuan { background: #8b9bb4; }
.ov-tag-he    { background: #b0a28a; }

.ov-desc {
  font-size: 20rpx;
  color: #e8e4db;
  white-space: nowrap;
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.5);
  font-weight: 500;
}

.ov-qi    { left: 10%;  top: 68%; }
.ov-cheng { left: 46%;  top: 44%; }
.ov-zhuan { left: 64%;  top: 18%; }
.ov-he    { left: 20%;  top: 10%; }

/* 连线标记 */
.ov-line {
  position: absolute;
}

.ov-arrow {
  font-size: 28rpx;
  color: rgba(255,255,255,0.65);
  text-shadow: 0 1rpx 4rpx rgba(0,0,0,0.5);
}

.ov-line-qc  { left: 22%;  top: 60%;  transform: rotate(-8deg);  }
.ov-line-cz  { left: 52%;  top: 34%;  transform: rotate(-42deg); }
.ov-line-zh  { left: 32%;  top: 12%;  transform: rotate(12deg);  }

/* ========= 内容卡片 (LLM via rich-text) ========= */
.content-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 2rpx 16rpx rgba(28, 25, 23, 0.04);
}

.content-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0ede8;
}

.content-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1c1917;
}

.content-ai-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: #292524;
  padding: 4rpx 14rpx;
  border-radius: 6rpx;
  letter-spacing: 1rpx;
}

.md-empty-state {
  text-align: center;
  padding: 48rpx 0;
  color: #a8a29e;
  font-size: 26rpx;
}

/* ========= 底部 ========= */
.footer-actions {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.btn-img-share {
  background: #292524;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
  padding: 28rpx 0;
  border: none;
  font-weight: 500;
  letter-spacing: 1rpx;
  width: 100%;
}

.footer-meta {
  text-align: center;
}

.footer-meta text {
  font-size: 22rpx;
  color: #c4bfb8;
}

/* ========= 错误 ========= */
.error-block {
  text-align: center;
  padding: 120rpx 0;
}

.error-icon {
  display: inline-flex;
  width: 80rpx;
  height: 80rpx;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  background: #292524;
  border-radius: 50%;
  margin-bottom: 32rpx;
}

.error-msg {
  display: block;
  font-size: 28rpx;
  color: #78716c;
  margin-bottom: 48rpx;
}

/* 分享图片 Canvas (隐藏) */
.share-canvas {
  position: fixed;
  left: 0;
  top: 9999rpx;
  width: 600rpx;
  height: 800rpx;
}
