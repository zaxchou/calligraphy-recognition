/* ===== 新中式轻奢 · 文人书卷气 ===== */
page {
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  color: #2c2416;
  background: #f8f5f0;
  line-height: 1.6;
}

/* ===== 颜色变量（文档用） ===== */
/* 底色: #f8f5f0  墨色: #2c2416  淡墨: #8b7d6b  暖金: #c9a96e  暗青: #204040  石青: #5b7a8c */

/* ===== 通用卡片 ===== */
.card {
  background: #faf8f5;
  border: 1rpx solid #d4c8b0;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-gold-left {
  border-left: 6rpx solid #c9a96e;
}

.card-gold-top {
  border-top: 4rpx solid #c9a96e;
}

/* ===== 搜索栏 ===== */
.search-wrap {
  padding: 20rpx 32rpx;
}
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid #c9a96e;
  border-radius: 48rpx;
  padding: 0 24rpx;
  height: 80rpx;
}
.search-box input {
  flex: 1;
  font-size: 28rpx;
  color: #2c2416;
}
.search-box .search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #c9a96e;
}
.search-box .search-clear {
  font-size: 28rpx;
  color: #8b7d6b;
  padding: 8rpx;
}

/* ===== 统计卡片行 ===== */
.stat-row {
  display: flex;
  gap: 16rpx;
  padding: 8rpx 32rpx 24rpx;
}
.stat-card {
  flex: 1;
  background: linear-gradient(135deg, #faf8f5, #f5f0e8);
  border: 1rpx solid #d4c8b0;
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}
.stat-card .stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #c9a96e;
}
.stat-card .stat-label {
  font-size: 22rpx;
  color: #8b7d6b;
  margin-top: 4rpx;
}

/* ===== 章节标题 ===== */
.section-title {
  padding: 24rpx 32rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #c9a96e;
  letter-spacing: 4rpx;
  text-align: center;
}
.section-title::before,
.section-title::after {
  content: '—';
  margin: 0 12rpx;
  opacity: 0.3;
}

/* ===== 书卡 ===== */
.book-list {
  padding: 0 32rpx;
}
.book-card {
  display: flex;
  background: #faf8f5;
  border: 1rpx solid #d4c8b0;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.book-card .book-cover {
  width: 88rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f5f0e8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}
.book-card .book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.book-card .book-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2c2416;
  margin-bottom: 6rpx;
}
.book-card .book-meta {
  font-size: 24rpx;
  color: #8b7d6b;
}
.book-card .book-status {
  font-size: 22rpx;
  color: #c9a96e;
  margin-top: 4rpx;
}

/* ===== 作品卡片 ===== */
.artwork-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx;
  gap: 16rpx;
}
.artwork-card {
  width: calc(50% - 8rpx);
  background: #faf8f5;
  border: 1rpx solid #d4c8b0;
  border-radius: 16rpx;
  overflow: hidden;
}
.artwork-card .artwork-img {
  width: 100%;
  height: 280rpx;
  background: #f0ebe0;
}
.artwork-card .artwork-info {
  padding: 16rpx 20rpx;
}
.artwork-card .artwork-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2416;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
  overflow: hidden;
}
.artwork-card .artwork-artist {
  font-size: 24rpx;
  color: #8b7d6b;
  margin-top: 4rpx;
}
.artwork-card .artwork-stats {
  font-size: 22rpx;
  color: #5b7a8c;
  margin-top: 4rpx;
}

/* ===== 筛选栏 ===== */
.filter-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 32rpx;
  gap: 16rpx;
}
.filter-bar .filter-picker {
  flex: 1;
  background: #faf8f5;
  border: 1rpx solid #d4c8b0;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: #2c2416;
}

/* ===== AI 摘要卡片 ===== */
.ai-summary-card {
  margin: 16rpx 32rpx 24rpx;
  background: #faf8f5;
  border: 1rpx solid #c9a96e;
  border-radius: 16rpx;
  padding: 24rpx;
}
.ai-summary-card .ai-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.ai-summary-card .ai-badge {
  background: #c9a96e;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 12rpx;
}
.ai-summary-card .ai-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c2416;
}

/* ===== 搜索结果 ===== */
.result-list {
  padding: 0 32rpx;
}
.result-item {
  background: #faf8f5;
  border: 1rpx solid #d4c8b0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}
.result-item .result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.result-item .result-book {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c2416;
}
.result-item .result-score {
  font-size: 22rpx;
  color: #c9a96e;
  padding: 2rpx 10rpx;
  background: #c9a96e10;
  border-radius: 8rpx;
}
.result-item .result-text {
  font-size: 26rpx;
  color: #555;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  line-height: 1.6;
}
.result-item .result-loc {
  font-size: 22rpx;
  color: #8b7d6b;
  margin-top: 8rpx;
}

/* ===== 书籍详情 ===== */
.detail-header {
  padding: 24rpx 32rpx;
}
.detail-header .detail-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c2416;
}
.detail-header .detail-meta {
  font-size: 24rpx;
  color: #8b7d6b;
  margin-top: 8rpx;
}
.detail-tabs {
  display: flex;
  border-bottom: 1rpx solid #d4c8b0;
  margin: 0 32rpx;
}
.detail-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #8b7d6b;
  position: relative;
}
.detail-tab.active {
  color: #c9a96e;
  font-weight: 600;
}
.detail-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 4rpx;
  background: #c9a96e;
  border-radius: 2rpx;
}

/* ===== 大纲树 ===== */
.outline-list {
  padding: 16rpx 32rpx;
}
.outline-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #ede4d8;
}
.outline-item .outline-chapter {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2416;
  display: flex;
  align-items: center;
}
.outline-item .outline-arrow {
  margin-right: 12rpx;
  font-size: 24rpx;
  color: #c9a96e;
  width: 32rpx;
  text-align: center;
}
.outline-item .outline-sections {
  margin-top: 8rpx;
  margin-left: 44rpx;
}
.outline-section {
  font-size: 24rpx;
  color: #8b7d6b;
  padding: 8rpx 0;
}

/* ===== 正文 Markdown 区 ===== */
.markdown-body {
  padding: 24rpx 32rpx;
}
.markdown-body rich-text {
  font-size: 28rpx;
  line-height: 1.8;
}

/* ===== 配图网格 ===== */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 16rpx 32rpx;
}
.image-grid image {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  border-radius: 8rpx;
  background: #f0ebe0;
}

/* ===== 大数据页面 ===== */
.data-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding: 24rpx 32rpx;
}
.data-section {
  padding: 16rpx 32rpx;
}
.data-section .data-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2416;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #c9a96e;
}
.chart-container {
  width: 100%;
  height: 400rpx;
  margin: 16rpx 0;
}
.qa-item {
  background: #faf8f5;
  border: 1rpx solid #d4c8b0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  overflow: hidden;
}
.qa-question {
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2c2416;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.qa-question .qa-arrow {
  font-size: 24rpx;
  color: #c9a96e;
  transition: transform 0.2s;
}
.qa-answer {
  padding: 0 24rpx 20rpx;
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  display: none;
}
.qa-item.open .qa-answer {
  display: block;
}
.qa-item.open .qa-arrow {
  transform: rotate(180deg);
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}
.empty-state .empty-icon {
  font-size: 80rpx;
  color: #d4c8b0;
  margin-bottom: 24rpx;
}
.empty-state .empty-text {
  font-size: 26rpx;
  color: #8b7d6b;
}

/* ===== 加载更多 ===== */
.load-more {
  text-align: center;
  padding: 24rpx;
  font-size: 24rpx;
  color: #8b7d6b;
}

/* ===== 作品详情 ===== */
.artwork-detail-img {
  width: 100%;
  background: #f0ebe0;
}
.artwork-detail-meta {
  padding: 24rpx 32rpx;
}
.artwork-detail-meta .meta-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2c2416;
}
.artwork-detail-meta .meta-row {
  font-size: 24rpx;
  color: #8b7d6b;
  margin-top: 8rpx;
}
.artwork-detail-section {
  padding: 16rpx 32rpx;
}
.artwork-detail-section .section-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #5b7a8c;
  margin-bottom: 8rpx;
}

/* ===== 标签 ===== */
.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  margin-right: 8rpx;
  margin-bottom: 8rpx;
}
.tag-gold { background: #c9a96e15; color: #c9a96e; }
.tag-blue { background: #5b7a8c15; color: #5b7a8c; }

/* ===== 导航栏返回按钮区 ===== */
.nav-back {
  padding: 16rpx 32rpx;
  font-size: 28rpx;
  color: #5b7a8c;
}

/* ===== 搜索模式提示 ===== */
.search-hint {
  text-align: center;
  padding: 16rpx 32rpx 8rpx;
  font-size: 24rpx;
  color: #8b7d6b;
}

/* ===== 搜索匹配结果卡 ===== */
.match-card {
  background: #fefcf5;
  border: 1rpx solid #c9a96e;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
}
.match-card .match-header {
  font-size: 24rpx;
  font-weight: 600;
  color: #c9a96e;
  margin-bottom: 12rpx;
}
.match-card .match-book {
  font-size: 24rpx;
  color: #5b7a8c;
  margin-bottom: 4rpx;
}
.match-card .match-loc {
  font-size: 22rpx;
  color: #8b7d6b;
  margin-bottom: 12rpx;
}
.match-card .match-text {
  font-size: 28rpx;
  color: #2c2416;
  line-height: 1.9;
}

/* ===== 隐藏滚动条 ===== */
::-webkit-scrollbar { display: none; }
